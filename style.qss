QMainWindow {
    background-color: #f4f4f6;
}

QWidget {
    font-family: "Roboto";
    font-size: 14px;
}

QListWidget{

    background-color: #f4f4f6;

    font-size: 42px;

    margin: 0px 0px 10px 0px;

    border: none;

    min-height: 740px;

}

QListWidget::item:selected {
    background-color: #e6e6e9;

    border-radius: 8px;
}

QLineEdit {
    min-height: 48px;

    font-size: 42px;
}

QLineEdit::placeholder {
    color: #e6e6e9;
}


QLabel#hintLabel {
    font-size: 64px;
    font-weight: 600;
    color: #000000;
    letter-spacing: 2px;
}


QLabel#subHintLabel {
    font-size: 18px;
    font-weight: 400;
    color: #66666e;
    letter-spacing: 1px;
}
