QMainWindow {
    background-color: #F1FAEE;
}

QListWidget{

    background-color: #F1FAEE;

    color: #1D3557;
    font-size: 42px;

    margin: 0px 0px 10px 0px;

    border: none;

    min-height: 740px;

}

QListWidget::item:selected {
    background-color: #457B9D;
    color: #1D3557;

    border-radius: 8px;
}
